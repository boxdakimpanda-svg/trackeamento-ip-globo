# Obrigatório em produção. Use um valor longo e aleatório.
ATLAS_ADMIN_TOKEN=

# Opcional: mantém os identificadores anônimos estáveis após trocar a senha.
ATLAS_HASH_SECRET=

# Configurações operacionais.
PORT=3000
HOST=0.0.0.0
ATLAS_RETENTION_DAYS=30
ATLAS_TRUST_PROXY_HOPS=1
# Deixe vazio para desativar consultas GeoIP externas.
ATLAS_GEOIP_URL=https://ipwho.is
ATLAS_DB_PATH=.data/atlas.sqlite
